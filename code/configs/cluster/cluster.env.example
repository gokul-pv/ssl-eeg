# Cluster settings sourced by scripts/slurm/*.sh. Edit for your cluster, or point
# SSL_EEG_CLUSTER_ENV at a copy. Jobs run with code/ as working directory.

# Container with the pyproject.toml environment (SSL_EEG_NO_CONTAINER=1 runs without it).
SINGULARITY_IMAGE=

# Host paths to bind besides code/ (raw EEG data), space-separated.
BIND_PATHS=

# SLURM .out/.err files (relative to code/).
SLURM_LOG_DIR=

# Hugging Face cache for the foundation-model weights; REVE also needs HF_TOKEN.
HF_HOME_DIR=
