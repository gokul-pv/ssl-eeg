  author = {Song, Yonghao and Zheng, Qingqing and Liu, Bingchuan and Gao, Xiaorong},
  date = {2023},
  journaltitle = {IEEE Transactions on Neural Systems and Rehabilitation Engineering},
  volume = {31},
